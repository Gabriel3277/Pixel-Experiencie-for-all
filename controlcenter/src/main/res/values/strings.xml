<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="cc_service_label">Central de controle Pixel</string>
    <string name="cc_service_description">Mostra o painel da Central de controle quando você desliza para baixo numa faixa do lado direito da tela e fecha o painel de notificações do sistema enquanto ele estiver aberto. Não lê o conteúdo da tela.</string>

    <string name="cc_screen_title">Central de controle</string>

    <string name="cc_howto_title">Como usar</string>
    <string name="cc_howto_body">Com o serviço ativado, deslize para baixo dentro da faixa do lado direito da tela (uma marquinha cinza mostra onde ela fica). O painel desce lá de cima. Para fechar, deslize para cima ou toque fora do painel.</string>

    <string name="cc_service_card_title">Serviço de acessibilidade</string>
    <string name="cc_service_card_body">Necessário para mostrar o painel sobre os outros apps. Não lê o conteúdo da tela.</string>
    <string name="cc_service_on">Ativado</string>
    <string name="cc_service_off">Desativado</string>
    <string name="cc_open_accessibility">Abrir Acessibilidade</string>

    <string name="cc_write_card_title">Permissão de brilho e rotação</string>
    <string name="cc_write_card_body">Permite alterar o brilho e a rotação automática. Sem ela, esses dois controles ficam bloqueados.</string>
    <string name="cc_write_granted">Concedida</string>
    <string name="cc_write_missing">Não concedida</string>
    <string name="cc_grant">Conceder</string>

    <string name="cc_module_off_title">Módulo desativado</string>
    <string name="cc_module_off_body">A Central de controle está desligada na tela inicial do app. Ative o módulo lá para o painel funcionar.</string>

    <string name="cc_limits_title">Nesta versão</string>
    <string name="cc_limits_body">Internet, Bluetooth e Modo avião abrem as telas do sistema, porque o Android não deixa apps ligar ou desligar esses itens diretamente. Notificações e mídia chegam na próxima parte.</string>

